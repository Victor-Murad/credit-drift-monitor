# Segredos e credenciais (kaggle.json nunca entra no repositorio)
.env
.env.*
*.env
kaggle.json
access_token

# Python / ambientes virtuais / caches
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Dados: o dataset Home Credit e licenciado pelo Kaggle apenas para uso
# academico e NAO pode ser redistribuido. Todos os datasets derivados sao
# regenerados com `make data` (ver README). Mantemos so a estrutura de pastas.
data/raw/*
data/reference/*
data/production/*
data/quarantine/*
data/samples/*
!data/**/.gitkeep

# Observabilidade local (Etapa 3): banco e artefatos do MLflow, estado local do DVC
/mlflow.db
/mlartifacts
/mlruns
.dvc/config.local
.dvc/cache
.dvc/tmp
# Estado local do Registry (champion servido) e saídas por lote dos comandos monitor e
# retrain (relatórios do contrato; a evidência vai anexada ao run no MLflow)
/models/champion/
/reports/monitor/
/reports/retrain/

# Logs de execucao (as evidencias versionadas ficam em reports/)
logs/

# OS / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ai-guides: memória privada local, team/ versionada
.claude/memory/*
!.claude/memory/team/
.gemini/memory/*
!.gemini/memory/team/
graphify-out

# Harness local (apenas .claude/ é versionado)
.agents/
